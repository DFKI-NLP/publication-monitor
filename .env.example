# Copy to .env and fill locally. Never commit .env.
# Quote values with single quotes when using the shell launcher.
DFKI_USER='your-intranet-username'
DFKI_PASS='replace-locally'
SMTP_USER='your-smtp-login@example.org'
SMTP_PASS='replace-locally'
# Optional: instead of a value above, use its NAME_FILE variable pointing to
# a readable local secret file. Do not set both forms.
# STATE_FILE=state/known_publication_ids.json
